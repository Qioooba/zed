[
  {
    "label": "Kairo: Compile (Ant)",
    "command": "ant",
    "args": ["compile"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Kairo: Clean Build (Ant)",
    "command": "ant",
    "args": ["clean", "compile"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Kairo: Package WAR (Ant)",
    "command": "ant",
    "args": ["war"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
